+    # Current Rabinizer 4's specialised ltl2ldba module constructs a
+    # non-generalised Buchi automaton by default; its CLI no longer accepts
+    # the former -d flag.
+    jar = os.environ.get('RABINIZER_JAR')
+    if not jar:
+        raise RuntimeError('RABINIZER_JAR must identify the frozen Rabinizer 4 jar.')
+    command = [
+        'java', '-classpath', jar, RABINIZER_MAIN,
+        '-i', formula, '-p', '-e',
+    ]
+    run = subprocess.run(command, capture_output=True, text=True, timeout=120, check=False)
+    if run.returncode != 0:
+        raise RuntimeError(
+            f'Rabinizer call failed with code {run.returncode}.\nError: {run.stderr}'
+        )
+    if not run.stdout.startswith('HOA: v1'):
+        raise RuntimeError('Rabinizer returned empty or non-HOA output.')
     return run.stdout
 
 
